# =============================================================================
# Stellar Wars — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Deploy contracts first:
#   1. npm run contracts:build
#   2. npm run contracts:deploy
#   3. Copy the printed contract IDs into the vars below.
# =============================================================================

# --- Stellar Network ---
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Generate a testnet keypair at https://laboratory.stellar.org/#account-creator
# then fund it via: npm run stellar:fund
ISSUER_PUBLIC_KEY=G...REPLACE_ME
ISSUER_SECRET_KEY=S...REPLACE_ME

# --- Soroban Contract Addresses ---
# Populated by: npm run contracts:deploy
MINT_CONTROLLER_CONTRACT=C...REPLACE_ME
BATTLE_REGISTRY_CONTRACT=C...REPLACE_ME
MARKETPLACE_CONTRACT=C...REPLACE_ME

# --- Database ---
DATABASE_URL=postgresql://stellar:wars@localhost:5432/stellarwars

# --- IPFS / Pinata (optional) ---
# Sign up at https://pinata.cloud and create API keys
PINATA_API_KEY=
PINATA_SECRET_KEY=

# --- App ---
PORT=4000
CLIENT_URL=http://localhost:3000

# Generate a random secret: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret
